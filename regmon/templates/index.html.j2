<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EU Reg Monitor</title>
<style>
  :root {
    --bg: #f6f4ef; --panel: #ffffff; --ink: #1a1f2b; --muted: #5f6675; --line: #dedad0;
    --accent: #1f3a5f; --accent-soft: #e5ebf3; --ok: #2f6b3a; --fail: #a03a2c;
    --AI: #6b3fa0; --Privacy: #1f6f8b; --Competition: #9a5b13; --IP: #2f6b3a;
    --Platforms: #a03a5c; --Other: #6b7280;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12151c; --panel: #1a1f29; --ink: #e8e6e1; --muted: #9aa1ae; --line: #2c3340;
      --accent: #9db8dc; --accent-soft: #233044; --ok: #7cc48a; --fail: #ef8a7a;
      --AI: #b79be0; --Privacy: #7cc3d9; --Competition: #e0a65e; --IP: #8fcf98;
      --Platforms: #e48fae; --Other: #a3a9b5;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  .wrap { max-width: 980px; margin: 0 auto; padding: 32px 16px 64px; }
  header { border-bottom: 2px solid var(--ink); padding-bottom: 18px; margin-bottom: 22px; }
  .kicker { text-transform: uppercase; letter-spacing: .14em; font-size: 12px; color: var(--muted); }
  h1 { font-family: "Iowan Old Style", Georgia, "Times New Roman", serif; font-weight: 600;
       font-size: clamp(30px, 5vw, 44px); line-height: 1.1; margin: 6px 0 10px; }
  .meta { color: var(--muted); font-size: 14px; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .meta b { color: var(--ink); font-variant-numeric: tabular-nums; }
  .banner { background: var(--accent-soft); color: var(--accent); border-radius: 8px; padding: 10px 14px; margin-bottom: 18px; font-size: 14px; font-weight: 600; }
  .controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .chip { border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 999px;
          padding: 6px 12px; font: inherit; font-size: 13px; cursor: pointer; }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .chip .n { opacity: .65; margin-left: 4px; font-variant-numeric: tabular-nums; }
  input[type=search], select { font: inherit; font-size: 14px; padding: 8px 10px; border-radius: 8px;
          border: 1px solid var(--line); background: var(--panel); color: var(--ink); }
  input[type=search] { flex: 1 1 240px; min-width: 0; }
  .count { color: var(--muted); font-size: 13px; margin: 0 0 10px; }
  ol.items { list-style: none; margin: 0; padding: 0; }
  .item { background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
          padding: 14px 16px; margin-bottom: 10px; }
  .item-top { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; font-size: 12.5px; color: var(--muted); }
  .tag { font-size: 11.5px; font-weight: 600; letter-spacing: .02em; padding: 2px 8px; border-radius: 4px;
         color: var(--c); background: color-mix(in srgb, var(--c) 12%, transparent); }
  .item h2 { font-family: "Iowan Old Style", Georgia, serif; font-size: 18px; font-weight: 600; margin: 6px 0 4px; line-height: 1.3; }
  .item h2 a { color: var(--ink); text-decoration: none; }
  .item h2 a:hover { color: var(--accent); text-decoration: underline; }
  .item p { margin: 0; color: var(--muted); font-size: 14px; }
  .empty { padding: 40px 0; text-align: center; color: var(--muted); }
  section.health { margin-top: 36px; border-top: 1px solid var(--line); padding-top: 18px; }
  section.health h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); margin: 0 0 10px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  td { padding: 6px 4px; border-bottom: 1px solid var(--line); vertical-align: top; }
  td.st { width: 70px; font-weight: 600; }
  .ok { color: var(--ok); } .fail { color: var(--fail); }
  td.err { color: var(--muted); font-size: 12.5px; word-break: break-word; }
  footer { margin-top: 28px; font-size: 12.5px; color: var(--muted); }
  footer a { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="kicker">Regulatory horizon scan · EU</div>
    <h1>EU Reg Monitor</h1>
    <div class="meta">
      <span>Updated <b>{{ generated_at }}</b></span>
      <span><b>{{ total }}</b> items tracked</span>
      <span><b>{{ last_run.new_items }}</b> new in last run</span>
      <span><b>{{ last_run.statuses | selectattr("ok") | list | length }}/{{ last_run.statuses | length }}</b> sources responding</span>
    </div>
  </header>
  {% if offline %}<div class="banner">Offline demo — synthetic fixture data from tests/fixtures, not real news.</div>{% endif %}

  <div class="chips" role="group" aria-label="Filter by area">
    <button class="chip" data-area="" aria-pressed="true">All<span class="n">{{ total }}</span></button>
    {% for a in areas %}
    <button class="chip" data-area="{{ a }}" aria-pressed="false">{{ a }}<span class="n">{{ counts[a] }}</span></button>
    {% endfor %}
  </div>
  <div class="controls">
    <input type="search" id="q" placeholder="Search titles and summaries…" aria-label="Search">
    <select id="src" aria-label="Filter by source">
      <option value="">All sources</option>
      {% for s in sources %}<option>{{ s }}</option>{% endfor %}
    </select>
  </div>
  <p class="count" id="count"></p>

  <ol class="items" id="items">
    {% for i in items %}
    <li class="item" data-areas="{{ i.areas | join('|') }}" data-source="{{ i.source_name }}">
      <div class="item-top">
        <span>{{ i.published or "undated" }}</span>
        <span>{{ i.source_name }}</span>
        {% for a in i.areas %}<span class="tag" style="--c: var(--{{ a.split(' ')[0] }}, var(--Other))">{{ a }}</span>{% endfor %}
      </div>
      <h2><a href="{{ i.url }}" target="_blank" rel="noopener">{{ i.title }}</a></h2>
      {% if i.summary %}<p>{{ i.summary }}</p>{% endif %}
    </li>
    {% endfor %}
  </ol>
  <div class="empty" id="empty" hidden>No items match these filters.</div>

  <section class="health">
    <h3>Source health — last run {{ last_run.run_at | replace("T", " ") | replace("+00:00", " UTC") }}</h3>
    <table>
      {% for s in last_run.statuses %}
      <tr>
        <td class="st {{ 'ok' if s.ok else 'fail' }}">{{ "OK" if s.ok else "FAIL" }}</td>
        <td>{{ s.name }}</td>
        {# s["items"], not s.items: on a dict, Jinja resolves .items to the dict method #}
        <td class="err">{{ (s["items"] ~ " items") if s.ok else s.error }}</td>
      </tr>
      {% endfor %}
    </table>
  </section>

  <footer>
    Built with regmon — fetched from public RSS feeds, tagged by keyword rules (rules.yaml), refreshed daily by GitHub Actions.
    Tags are automated and indicative, not legal advice. <a href="data.json">JSON export</a>.
  </footer>
</div>
<script>
(function () {
  var area = "", items = Array.prototype.slice.call(document.querySelectorAll(".item"));
  var q = document.getElementById("q"), src = document.getElementById("src");
  var count = document.getElementById("count"), empty = document.getElementById("empty");
  function apply() {
    var term = q.value.trim().toLowerCase(), s = src.value, shown = 0;
    items.forEach(function (el) {
      var ok = (!area || el.dataset.areas.split("|").indexOf(area) > -1)
            && (!s || el.dataset.source === s)
            && (!term || el.textContent.toLowerCase().indexOf(term) > -1);
      el.hidden = !ok; if (ok) shown++;
    });
    count.textContent = shown + " of " + items.length + " items";
    empty.hidden = shown > 0;
  }
  document.querySelectorAll(".chip").forEach(function (b) {
    b.addEventListener("click", function () {
      area = b.dataset.area;
      document.querySelectorAll(".chip").forEach(function (c) { c.setAttribute("aria-pressed", c === b ? "true" : "false"); });
      apply();
    });
  });
  q.addEventListener("input", apply); src.addEventListener("change", apply);
  apply();
})();
</script>
</body>
</html>
